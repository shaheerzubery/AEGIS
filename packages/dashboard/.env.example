# AEGIS dashboard frontend config — Vite convention: this file (and a copy
# named ".env" that you create from it) is loaded relative to THIS package,
# not the repo root. This is the one setting Vite genuinely can't get from
# ../../config.py (the settings file for everything else in this repo) —
# Vite only reads .env-format files, not Python. See
# ../../docs/configuration.md.
#
# Copy this file to ".env" in this same directory and edit it.

# Where the browser should reach packages/dashboard/api/dashboard_api.py.
# Demo default assumes the Compose stack's port-forwarded localhost —
# should match config.py's DASHBOARD_API_PORT. Point this at a real
# dashboard-api URL (e.g. https://aegis-dashboard-api.example.com) for a
# production deployment.
VITE_AEGIS_DASHBOARD_API=http://localhost:9900
